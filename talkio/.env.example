# --- Auth ---
# true = anyone can sign in with just an email + name (no Google setup needed).
# Keep true for LAN testing with friends. Set to false only if you wire up real Google Sign-In.
DEV_MODE=true

# Only needed if DEV_MODE=false. From https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=

# Signs session tokens. Any long random string works — generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-in-production

# --- Nova (built-in AI assistant) & personal agents ---
# Optional. Without it, Nova replies in offline mode and Claude-backed
# personal agents just won't be usable (Ollama agents still work fine).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Only used by main.py's LAN-IP detection for the startup banner / Ollama auto-detect.
OLLAMA_DETECT_PORT=11434
